# Optional for local development with the Firebase Functions emulator.
# Production uses the Firebase Hosting /api/send-booking rewrite.
# Without this URL, local development runs a clearly labeled notification preview.
NEXT_PUBLIC_BOOKING_API_URL=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/sendBookingNotification
# To force a notification preview in a deployed build, set this to true before building.
# NEXT_PUBLIC_DEMO_MODE=true
